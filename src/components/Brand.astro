---
/** The PracticeOp wordmark: type only, no mark. "Op" takes the mint accent. */
import { siteConfig } from '../config/site';
import { url } from '../utils/url';

const { brand, name } = siteConfig;
---

<a href={url('/')} class="brand">
  <b>{brand.prefix}<i>{brand.accent}</i>{brand.suffix}</b><span class="sr-only"> {name} home</span>
</a>
