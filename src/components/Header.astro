---
import Brand from './Brand.astro';
import { mainNav } from '../data/navigation';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
import { ariaCurrent } from '../utils/nav';

interface Props {
  pitch?: boolean;
}

const { pitch = true } = Astro.props;
const path = Astro.url.pathname;
---

<header class="hdr" id="hdr">
  <div class="wrap">
    <div class="hdr__in">
      <Brand />
      <nav class="mainnav" aria-label="Main">
        <ul>
          {mainNav.map((item) => (
            <li><a href={url(item.href)} aria-current={ariaCurrent(item, path)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      {pitch ? <a href={url(siteConfig.cta.href)} class="btn btn--ow">{siteConfig.cta.shortLabel}</a> : <a href={url('/#contact')} class="btn btn--ow">Contact</a>}
      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mob">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
